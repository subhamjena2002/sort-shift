{
  "name": "sort-shift",
  "private": true,
  "version": "0.1.0",
  "description": "SORT SHIFT — Neon Parcel Depot. An endless arcade sorting game built with Phaser 4.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:e2e": "vite --mode e2e --port 5199 --strictPort",
    "test:e2e": "playwright test --grep-invert @soak",
    "test:e2e:soak": "playwright test --grep @soak",
    "verify:prod": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
